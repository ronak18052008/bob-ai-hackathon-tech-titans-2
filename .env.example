# =============================================================================
# MedBrief AI - Environment Configuration Template
# Step 1: Project Setup (Placeholders only - Do NOT put real secrets here)
# =============================================================================

# Application Environment
APP_ENV=production
APP_PORT=8000
PORT=8000

# CORS Allowed Origins (comma-separated, no wildcards with credentials in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Private Medical Document Storage (Step 7)
STORAGE_DIR=storage/documents
MAX_DOCUMENT_SIZE_MB=25

# Database / Supabase Configuration (Step 3)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication & RBAC Configuration (Step 4)
# Generate a cryptographically secure random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini API Configuration (Step 8)
# Keep strictly backend-only. Never expose to client bundles or commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_INPUT_CHARS=100000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3

# Frontend Configuration
VITE_API_URL=http://localhost:8000

